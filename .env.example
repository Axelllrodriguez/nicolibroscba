# Conexión a la base de datos PostgreSQL (ej. Neon, Supabase o local)
DATABASE_URL="postgresql://usuario:password@localhost:5432/nicolibros"

# Configuración del panel de administración (/admin)
ADMIN_EMAIL="admin@ejemplo.com"
# Hash bcrypt de la contraseña (generado con node)
ADMIN_PASSWORD_HASH=""
# Clave secreta para firmar sesiones (al menos 32 caracteres)
SESSION_SECRET=""

# Configuración del servidor local
PORT=3000
HOST=127.0.0.1
